<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="gt_field_sales_visit_planner.VisitExecutionWidget">
        <div class="o_gt_visit_execution d-flex flex-column gap-2 my-2">
            <p class="text-muted mb-1">Location is captured only when you start check-in or check-out. Browser GPS is device-reported evidence, not cryptographic proof of presence.</p>
            <div class="d-flex flex-wrap gap-2">
                <button t-if="visitState === 'planned'" type="button" class="btn btn-primary" t-att-disabled="state.pending" t-on-click="() => this.onExecute('check_in')">
                    <t t-if="state.pending">Getting location...</t><t t-else="">Check In</t>
                </button>
                <button t-if="visitState === 'checked_in'" type="button" class="btn btn-primary" t-att-disabled="state.pending" t-on-click="() => this.onExecute('check_out')">
                    <t t-if="state.pending">Getting location...</t><t t-else="">Check Out</t>
                </button>
                <button t-if="state.retryPayload &amp;&amp; !state.pending" type="button" class="btn btn-secondary" t-on-click="onRetry">Retry same request</button>
                <button t-if="state.captureError &amp;&amp; !state.pending" type="button" class="btn btn-outline-secondary" t-on-click="() => this.onContinueWithoutLocation(visitState === 'planned' ? 'check_in' : 'check_out')">Continue without location for policy review</button>
            </div>
            <div t-if="state.captureError" class="alert alert-warning mb-0" role="status"><t t-esc="state.captureError"/></div>
            <div t-if="state.error" class="alert alert-danger mb-0" role="alert"><t t-esc="state.error"/></div>
        </div>
    </t>
</templates>
