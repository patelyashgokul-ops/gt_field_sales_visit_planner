<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <t t-name="gt_field_sales_visit_planner.Dashboard">
    <div class="o_gt_sales_dashboard">
      <div class="o_gt_sales_header">
        <div><span class="o_gt_eyebrow">GOLOK TECHNOLOGY · FIELD SALES</span><h1>Field Sales Dashboard</h1><p>Visit planning, customer coverage and follow-up health</p></div>
        <button class="btn btn-primary" t-on-click="this.reload" t-att-disabled="this.state.loading"><i class="fa fa-refresh me-1"/> Refresh</button>
      </div>
      <div class="o_gt_filterbar">
        <label>Company<select class="form-select" t-att-value="this.state.filters.company_id" t-on-change="this.onCompanyChange"><option t-foreach="this.state.data?.companies || []" t-as="company" t-key="company.id" t-att-value="company.id"><t t-esc="company.name"/></option></select></label>
        <label>Scheduled From<input type="date" class="form-control" t-att-value="this.state.filters.date_from" t-on-change="this.onDateFromChange"/></label>
        <label>Scheduled To<input type="date" class="form-control" t-att-value="this.state.filters.date_to" t-on-change="this.onDateToChange"/></label>
        <label>Territory<select class="form-select" t-att-value="this.state.filters.territory_id" t-on-change="this.onTerritoryChange"><option value="">All authorized territories</option><option t-foreach="this.state.data?.territories || []" t-as="territory" t-key="territory.id" t-att-value="territory.id"><t t-esc="territory.name"/></option></select></label>
        <label t-if="this.state.data?.salespeople.length &gt; 1">Salesperson<select class="form-select" t-att-value="this.state.filters.user_id" t-on-change="this.onSalespersonChange"><option value="">All authorized salespeople</option><option t-foreach="this.state.data?.salespeople || []" t-as="salesperson" t-key="salesperson.id" t-att-value="salesperson.id"><t t-esc="salesperson.name"/></option></select></label>
      </div>
      <div t-if="this.state.error" class="alert alert-danger" role="alert"><t t-esc="this.state.error"/></div>
      <div t-if="this.state.loading" class="o_gt_loading" role="status">Loading authorized reporting data…</div>
      <t t-if="this.state.data &amp;&amp; !this.state.loading">
        <p class="o_gt_date_basis"><i class="fa fa-info-circle me-1"/><t t-esc="this.state.data.date_basis"/> <span>Period: <t t-esc="this.state.data.filters.date_from"/> to <t t-esc="this.state.data.filters.date_to"/> (<t t-esc="this.state.data.filters.timezone"/>)</span></p>
        <nav class="o_gt_tabs" aria-label="Field Sales reports">
          <button t-att-class="this.state.report === 'overview' ? 'active' : ''" t-on-click="() => this.selectReport('overview')">Overview</button>
          <button t-foreach="Object.entries(this.reportOptions)" t-as="entry" t-key="entry[0]" t-att-class="this.state.report === entry[0] ? 'active' : ''" t-on-click="() => this.selectReport(entry[0])"><t t-esc="entry[1].label"/></button>
        </nav>
        <t t-if="this.state.report === 'overview'">
          <div class="o_gt_kpis">
            <button class="o_gt_kpi" t-on-click="() => this.openMetric('eligible_planned')"><span>Eligible Planned</span><strong t-esc="this.state.data.kpis.eligible_planned"/><small>Confirmed plan cohort</small></button>
            <button class="o_gt_kpi" t-on-click="() => this.openMetric('completed')"><span>Completed</span><strong t-esc="this.state.data.kpis.completed"/><small>With check-in and checkout evidence</small></button>
            <div class="o_gt_kpi"><span>Completion Rate</span><strong><t t-if="this.state.data.kpis.completion_rate !== null"><t t-esc="this.state.data.kpis.completion_rate"/>%</t><t t-else="">—</t></strong><small t-esc="this.state.data.kpis.eligible_planned ? 'Completed / eligible planned' : 'No eligible planned visits'"/></div>
            <button class="o_gt_kpi o_gt_kpi_warning" t-on-click="() => this.openMetric('missed')"><span>Missed</span><strong t-esc="this.state.data.kpis.states.missed"/><small>Explicitly recorded only</small></button>
            <button class="o_gt_kpi" t-on-click="() => this.openMetric('unexecuted')"><span>Unexecuted</span><strong t-esc="this.state.data.kpis.unexecuted"/><small><t t-esc="this.state.data.kpis.overdue_unexecuted"/> overdue by reporting date</small></button>
            <div class="o_gt_kpi"><span>Current Allocation Coverage</span><strong><t t-if="this.state.data.kpis.coverage_percent !== null"><t t-esc="this.state.data.kpis.coverage_percent"/>%</t><t t-else="">—</t></strong><small><t t-esc="this.state.data.kpis.territories_covered"/> of <t t-esc="this.state.data.kpis.territory_count"/> territories with visits</small></div>
            <button class="o_gt_kpi o_gt_kpi_warning" t-on-click="() => this.selectReport('followups')"><span>Overdue Follow-ups</span><strong t-esc="this.state.data.kpis.overdue_followups"/><small>Open source-linked activities</small></button>
            <button class="o_gt_kpi o_gt_kpi_warning" t-on-click="() => this.selectReport('exceptions')"><span>Pending GPS Review</span><strong t-esc="this.state.data.kpis.pending_gps_exceptions"/><small>Separate from business completion</small></button>
          </div>
          <div class="o_gt_panels">
            <section class="o_gt_panel"><h2>Visit status</h2><div t-foreach="Object.entries(this.state.data.states)" t-as="entry" t-key="entry[0]" class="o_gt_status_row"><span t-esc="this.labelStatus(entry[0])"/><strong t-esc="entry[1]"/></div></section>
            <section class="o_gt_panel"><h2>Scheduled visit trend</h2><p class="text-muted">By scheduled local visit date</p><div t-if="!this.state.data.trends.length" class="o_gt_empty">No scheduled visit records in this period.</div><div t-foreach="this.state.data.trends" t-as="point" t-key="point.date" class="o_gt_bar_row"><span t-esc="point.date"/><div class="o_gt_bar_track"><span class="o_gt_bar_planned" t-att-style="'width:' + (point.planned / this.maxTrend * 100) + '%'"/><span class="o_gt_bar_completed" t-att-style="'width:' + (point.completed / this.maxTrend * 100) + '%'"/></div><strong><t t-esc="point.completed"/> / <t t-esc="point.planned"/></strong></div><div class="o_gt_legend"><span>Planned</span><span>Completed</span></div></section>
            <section class="o_gt_panel"><div class="o_gt_panel_title"><h2 t-esc="this.state.data.current_allocation_label"/><button class="btn btn-link" t-on-click="() => this.selectReport('territories')">Full report</button></div><div t-if="!this.state.data.coverage.length" class="o_gt_empty">No active customer allocations in the selected scope.</div><div t-foreach="this.state.data.coverage" t-as="row" t-key="row.territory_id" class="o_gt_metric_row"><span t-esc="row.territory"/><div class="o_gt_bar_track"><span class="o_gt_bar_coverage" t-att-style="'width:' + (row.coverage_percent || 0) + '%'"/></div><strong><t t-esc="row.customers_visited"/> / <t t-esc="row.allocated_customers"/></strong></div></section>
            <section class="o_gt_panel"><div class="o_gt_panel_title"><h2>Business outcomes</h2><button class="btn btn-link" t-on-click="() => this.selectReport('outcomes')">Full report</button></div><div t-if="!this.state.data.outcomes.length" class="o_gt_empty">No completed visit outcomes in this period.</div><div t-foreach="this.state.data.outcomes" t-as="row" t-key="row.code" class="o_gt_metric_row"><span t-esc="row.outcome"/><strong t-esc="row.visits"/></div><small>Uses the outcome snapshot recorded at completion.</small></section>
          </div>
        </t>
        <section t-else="" class="o_gt_panel o_gt_report_panel">
          <div class="o_gt_panel_title"><div><h2 t-esc="this.reportOptions[this.state.report].label"/><small>Scheduled visit date cohort: <t t-esc="this.state.data.filters.date_from"/> through <t t-esc="this.state.data.filters.date_to"/></small></div><div class="o_gt_export"><a class="btn btn-outline-primary" t-att-href="this.exportUrl('csv')">Download CSV</a><a class="btn btn-outline-secondary" t-att-href="this.exportUrl('xlsx')">Download XLSX</a></div></div>
          <div t-if="this.state.reportLoading" class="o_gt_loading">Loading report…</div><div t-elif="!this.state.rows.length" class="o_gt_empty">No report rows match these filters.</div>
          <div t-else="" class="table-responsive"><table class="table table-hover"><thead><tr><th t-foreach="this.reportColumns" t-as="column" t-key="column[0]" t-esc="column[1]"/></tr></thead><tbody><tr t-foreach="this.state.rows" t-as="row" t-key="row.visit_id || row.territory_id || row.partner_id || row.user_id || row.customer || row.code"><td t-foreach="this.reportColumns" t-as="column" t-key="column[0]" t-esc="row[column[0]] ?? ''"/></tr></tbody></table></div>
          <small t-if="this.state.report === 'territories'">Coverage uses current active allocations. P01 does not keep effective-dated ownership periods.</small>
          <small t-if="this.state.report === 'followups'">Only currently open source-linked Odoo activities are listed. A deleted/archived task is not counted completed without P04 completion evidence.</small>
          <small t-if="this.state.report === 'exceptions'">GPS classification and manager review decision are separate. No precise coordinates are included here.</small>
        </section>
      </t>
    </div>
  </t>
</templates>
