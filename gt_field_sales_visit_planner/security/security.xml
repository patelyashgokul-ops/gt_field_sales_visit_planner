<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="category_field_sales" model="ir.module.category">
        <field name="name">Field Sales</field>
    </record>
    <record id="privilege_field_sales" model="res.groups.privilege">
        <field name="name">Field Sales Access</field>
        <field name="category_id" ref="category_field_sales"/>
    </record>
    <record id="group_field_salesperson" model="res.groups">
        <field name="name">Field Salesperson</field>
        <field name="privilege_id" ref="privilege_field_sales"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
    </record>
    <record id="group_sales_manager" model="res.groups">
        <field name="name">Sales Manager</field>
        <field name="privilege_id" ref="privilege_field_sales"/>
        <field name="implied_ids" eval="[Command.link(ref('group_field_salesperson'))]"/>
    </record>
    <record id="group_field_sales_admin" model="res.groups">
        <field name="name">Field Sales Administrator</field>
        <field name="privilege_id" ref="privilege_field_sales"/>
        <field name="implied_ids" eval="[Command.link(ref('group_sales_manager'))]"/>
    </record>
    <record id="rule_territory_company" model="ir.rule">
        <field name="name">Field sales territory company boundary</field>
        <field name="model_id" ref="model_gt_sales_territory"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_assignment_company" model="ir.rule">
        <field name="name">Field sales assignment company boundary</field>
        <field name="model_id" ref="model_gt_sales_territory_assignment"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_allocation_company" model="ir.rule">
        <field name="name">Field sales allocation company boundary</field>
        <field name="model_id" ref="model_gt_sales_territory_customer"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_territory_salesperson" model="ir.rule">
        <field name="name">Assigned territories</field>
        <field name="model_id" ref="model_gt_sales_territory"/>
        <field name="groups" eval="[Command.link(ref('group_field_salesperson'))]"/>
        <field name="domain_force">[('assignment_ids.user_id', '=', user.id)]</field>
    </record>
    <record id="rule_assignment_salesperson" model="ir.rule">
        <field name="name">Own field sales assignments</field>
        <field name="model_id" ref="model_gt_sales_territory_assignment"/>
        <field name="groups" eval="[Command.link(ref('group_field_salesperson'))]"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
    </record>
    <record id="rule_allocation_salesperson" model="ir.rule">
        <field name="name">Allocations in assigned territories</field>
        <field name="model_id" ref="model_gt_sales_territory_customer"/>
        <field name="groups" eval="[Command.link(ref('group_field_salesperson'))]"/>
        <field name="domain_force">[('territory_id.assignment_ids.user_id', '=', user.id)]</field>
    </record>
    <record id="rule_territory_manager" model="ir.rule">
        <field name="name">Manager territories</field>
        <field name="model_id" ref="model_gt_sales_territory"/>
        <field name="groups" eval="[Command.link(ref('group_sales_manager'))]"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_assignment_manager" model="ir.rule">
        <field name="name">Manager assignments</field>
        <field name="model_id" ref="model_gt_sales_territory_assignment"/>
        <field name="groups" eval="[Command.link(ref('group_sales_manager'))]"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_allocation_manager" model="ir.rule">
        <field name="name">Manager allocations</field>
        <field name="model_id" ref="model_gt_sales_territory_customer"/>
        <field name="groups" eval="[Command.link(ref('group_sales_manager'))]"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
