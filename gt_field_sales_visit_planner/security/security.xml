<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="category_field_sales" model="ir.module.category"><field name="name">Field Sales</field></record>
    <record id="privilege_field_sales" model="res.groups.privilege"><field name="name">Field Sales Access</field><field name="category_id" ref="category_field_sales"/></record>
    <record id="group_field_salesperson" model="res.groups"><field name="name">Field Salesperson</field><field name="privilege_id" ref="privilege_field_sales"/><field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/></record>
    <record id="group_sales_manager" model="res.groups"><field name="name">Sales Manager</field><field name="privilege_id" ref="privilege_field_sales"/><field name="implied_ids" eval="[Command.link(ref('group_field_salesperson'))]"/></record>
    <record id="group_field_sales_admin" model="res.groups"><field name="name">Field Sales Administrator</field><field name="privilege_id" ref="privilege_field_sales"/><field name="implied_ids" eval="[Command.link(ref('group_sales_manager'))]"/></record>

    <record id="rule_execution_policy_company" model="ir.rule"><field name="name">GPS policy company boundary</field><field name="model_id" ref="model_gt_sales_execution_policy"/><field name="domain_force">[('company_id', 'in', company_ids)]</field><field name="global" eval="True"/></record>
    <record id="rule_customer_location_company" model="ir.rule"><field name="name">Customer visit location company boundary</field><field name="model_id" ref="model_gt_sales_customer_location"/><field name="domain_force">[('company_id', 'in', company_ids)]</field><field name="global" eval="True"/></record>
    <record id="rule_visit_event_company" model="ir.rule"><field name="name">Visit evidence company boundary</field><field name="model_id" ref="model_gt_sales_visit_event"/><field name="domain_force">[('company_id', 'in', company_ids)]</field><field name="global" eval="True"/></record>
    <record id="rule_visit_event_salesperson" model="ir.rule"><field name="name">Own visit evidence only</field><field name="model_id" ref="model_gt_sales_visit_event"/><field name="domain_force">[('visit_id.user_id', '=', user.id)]</field><field name="groups" eval="[Command.link(ref('group_field_salesperson'))]"/></record>
    <record id="rule_visit_event_manager" model="ir.rule"><field name="name">Manager visit evidence companies</field><field name="model_id" ref="model_gt_sales_visit_event"/><field name="domain_force">[('company_id', 'in', company_ids)]</field><field name="groups" eval="[Command.link(ref('group_sales_manager'))]"/></record>
    <record id="rule_visit_exception_company" model="ir.rule"><field name="name">Location exception company boundary</field><field name="model_id" ref="model_gt_sales_visit_location_exception"/><field name="domain_force">[('company_id', 'in', company_ids)]</field><field name="global" eval="True"/></record>
    <record id="rule_visit_exception_salesperson" model="ir.rule"><field name="name">Own location exceptions only</field><field name="model_id" ref="model_gt_sales_visit_location_exception"/><field name="domain_force">[('user_id', '=', user.id)]</field><field name="groups" eval="[Command.link(ref('group_field_salesperson'))]"/></record>
    <record id="rule_visit_exception_manager" model="ir.rule"><field name="name">Manager location exceptions by company</field><field name="model_id" ref="model_gt_sales_visit_location_exception"/><field name="domain_force">[('company_id', 'in', company_ids)]</field><field name="groups" eval="[Command.link(ref('group_sales_manager'))]"/></record>
</odoo>
