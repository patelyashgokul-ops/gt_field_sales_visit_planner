<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_visit_plan_list" model="ir.ui.view"><field name="name">gt.sales.visit.plan.list</field><field name="model">gt.sales.visit.plan</field><field name="arch" type="xml"><list decoration-success="state == 'confirmed'" decoration-muted="state == 'cancelled'"><field name="name"/><field name="visit_date"/><field name="user_id"/><field name="territory_id"/><field name="planned_visit_count"/><field name="state"/><field name="company_id" groups="base.group_multi_company"/></list></field></record>
  <record id="view_visit_plan_form" model="ir.ui.view"><field name="name">gt.sales.visit.plan.form</field><field name="model">gt.sales.visit.plan</field><field name="arch" type="xml"><form><header><button name="action_confirm" type="object" string="Confirm Plan" class="oe_highlight" invisible="state != 'draft'"/><button name="action_open_cancel" type="object" string="Cancel Plan" invisible="state == 'cancelled'"/><field name="state" widget="statusbar" statusbar_visible="draft,confirmed,cancelled"/></header><sheet><div class="oe_title"><h1><field name="name"/></h1></div><group><group><field name="company_id"/><field name="user_id"/><field name="territory_id" domain="[('company_id', '=', company_id), ('active', '=', True)]"/></group><group><field name="visit_date"/><field name="timezone"/><field name="planned_visit_count"/><field name="confirmed_by" invisible="not confirmed_by"/><field name="confirmed_at" invisible="not confirmed_at"/></group></group><notebook><page string="Route"><field name="visit_ids" context="{'default_plan_id': id}" readonly="state != 'draft'"><list editable="bottom" default_order="sequence,id"><field name="sequence" widget="handle"/><field name="partner_id" domain="['|', ('company_id', '=', False), ('company_id', '=', parent.company_id)]"/><field name="crm_lead_id" domain="[('partner_id', '=', partner_id), ('company_id', '=', parent.company_id)]"/><field name="planned_start_at"/><field name="planned_end_at"/><field name="state"/><field name="planning_notes"/></list></field></page><page string="Notes"><field name="notes"/><field name="cancellation_reason" readonly="1"/><field name="cancelled_by" readonly="1"/><field name="cancelled_at" readonly="1"/></page></notebook></sheet></form></field></record>
  <record id="view_visit_plan_search" model="ir.ui.view"><field name="name">gt.sales.visit.plan.search</field><field name="model">gt.sales.visit.plan</field><field name="arch" type="xml"><search><field name="name"/><field name="user_id"/><field name="territory_id"/><field name="visit_date"/><filter name="draft" string="Draft" domain="[('state','=','draft')]"/><filter name="confirmed" string="Confirmed" domain="[('state','=','confirmed')]"/><filter name="cancelled" string="Cancelled" domain="[('state','=','cancelled')]"/><filter name="group_day" string="Group by Date" context="{'group_by':'visit_date'}"/></search></field></record>
  <record id="view_visit_list" model="ir.ui.view"><field name="name">gt.sales.visit.list</field><field name="model">gt.sales.visit</field><field name="arch" type="xml"><list default_order="planned_date desc,sequence,id"><field name="planned_date"/><field name="sequence"/><field name="partner_id"/><field name="user_id"/><field name="territory_id"/><field name="state"/><field name="plan_id"/></list></field></record>
  <record id="view_visit_search" model="ir.ui.view"><field name="name">gt.sales.visit.search</field><field name="model">gt.sales.visit</field><field name="arch" type="xml"><search><field name="partner_id"/><field name="plan_id"/><field name="user_id"/><field name="territory_id"/><field name="planned_date"/><filter name="active_visits" string="Active visits" domain="[('state','in',['draft','planned'])]"/></search></field></record>
  <record id="action_my_plans" model="ir.actions.act_window"><field name="name">My Daily Plans</field><field name="res_model">gt.sales.visit.plan</field><field name="view_mode">list,form</field><field name="domain">[('user_id','=',uid)]</field><field name="context">{'default_user_id': uid}</field><field name="help" type="html"><p class="o_view_nocontent_smiling_face">Create a daily visit plan</p></field></record>
  <record id="action_team_plans" model="ir.actions.act_window"><field name="name">Team Visit Plans</field><field name="res_model">gt.sales.visit.plan</field><field name="view_mode">list,form</field></record>
  <record id="action_all_visits" model="ir.actions.act_window"><field name="name">All Planned Visits</field><field name="res_model">gt.sales.visit</field><field name="view_mode">list</field></record>
  <menuitem id="menu_my_plans" name="My Daily Plans" parent="menu_field_sales" action="action_my_plans" sequence="10" groups="group_field_salesperson"/>
  <menuitem id="menu_team_plans" name="Team Visit Plans" parent="menu_field_sales" action="action_team_plans" sequence="15" groups="group_sales_manager,group_field_sales_admin"/>
  <menuitem id="menu_all_visits" name="All Planned Visits" parent="menu_field_sales" action="action_all_visits" sequence="20" groups="group_sales_manager,group_field_sales_admin"/>
</odoo>
